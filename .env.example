# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
# Tiger Cloud connection string. The console's .env download calls it
# TIMESCALE_SERVICE_URL; TIGER_URL works too. Ask the team for the value.
# Leave it unset to run on the bundled seed data instead.
TIMESCALE_SERVICE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Optional overrides
# PORT=8787
# DATA_BACKEND=mock        # force seed data even when a URL is set
# AI_BACKEND=mock          # mock | gemini | none
# GEMINI_API_KEY=
# SANITY_VETO=false        # skip the yes/no veto on top candidates
